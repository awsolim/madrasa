# Copy to .env.test.local. Never use production Supabase or Stripe credentials here.
MADRASA_TEST_ENVIRONMENT=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Values printed by: npx supabase start
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# Stripe Dashboard > Developers > API keys while Test mode is enabled.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_with_test_webhook_secret

# Leave RESEND_API_KEY empty to suppress application emails. To inspect real
# rendered deliveries, set it and force every message to your own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_TEST_RECIPIENT=your-own-email@example.com
